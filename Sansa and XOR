#include <iostream>
#include <vector>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;
        vector<int> arr(n);

        for (int i = 0; i < n; ++i) {
            cin >> arr[i];
        }

        int result = 0;

        if (n % 2 != 0) {
            for (int i = 0; i < n; i += 2) {
                result ^= arr[i];
            }
        }

        cout << result << endl;
    }

    return 0;
}
