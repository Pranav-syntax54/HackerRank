#include <iostream>
#include <vector>
using namespace std;

string fairRations(vector<int> B) {
    int n = B.size();
    int loaves = 0;

    // Brute-force: keep looping until no odd numbers remain or impossible
    bool changed = true;
    while (changed) {
        changed = false;
        for (int i = 0; i < n - 1; ++i) {
            if (B[i] % 2 != 0) {
                B[i]++;
                B[i + 1]++;
                loaves += 2;
                changed = true;
            }
        }
    }

    // Final check: if any odd remains, it's impossible
    for (int i = 0; i < n; ++i) {
        if (B[i] % 2 != 0) return "NO";
    }

    return to_string(loaves);
}

int main() {
    int n;
    cin >> n;
    vector<int> B(n);
    for (int i = 0; i < n; ++i) {
        cin >> B[i];
    }
    cout << fairRations(B) << endl;
    return 0;
}
